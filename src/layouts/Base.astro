---
import '../styles/global.css';
import { company, nav, cta, staffLogin } from '../config';
import { domestic } from '../data';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const fullTitle = title === company.name ? `${company.name} | Building Management Systems` : `${title} | ${company.name}`;
const path = Astro.url.pathname;
const isActive = (href: string) => !href.includes('#') && path.startsWith(href.replace(/\/$/, ''));
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/images/logo-icon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=Instrument+Sans:wght@400;500;600&display=swap" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/images/logo.png', Astro.site)} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="brand" aria-label={`${company.name} home`}>
          <img src="/images/logo.png" alt="" width="536" height="601" />
        </a>
        <details class="menu">
          <summary aria-label="Menu">Menu</summary>
          <nav aria-label="Main">
            <ul>
              {nav.map((item) => (
                <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
              ))}
              <li><a class="nav-cta" href={cta.href}>{cta.label}</a></li>
            </ul>
          </nav>
        </details>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <span class="brand brand--footer">
            <img src="/images/logo.png" alt={company.name} width="536" height="601" />
          </span>
          <span>
            {company.legalName}. Registered in England and Wales{company.companyNumber ? `, company number ${company.companyNumber}` : ''}.
            {company.registeredOffice && <><br />Registered office: {company.registeredOffice}</>}
          </span>
        </div>
        <div class="footer-cols">
          <div>
            <strong>Commercial</strong>
            <a href="/services/#design-install">BMS installation</a>
            <a href="/services/#upgrades">Upgrades</a>
            <a href="/services/#maintenance">Maintenance</a>
          </div>
          <div>
            <strong>Domestic</strong>
            {domestic.slice(0, 3).map((d) => <a href="/domestic/">{d.title}</a>)}
          </div>
          <div>
            <strong>Contact</strong>
            {company.phone && <a href={`tel:${company.phone.replace(/\s/g, '')}`}>{company.phone}</a>}
            {company.email && <a href={`mailto:${company.email}`}>{company.email}</a>}
            {company.linkedin && <a href={company.linkedin} rel="noopener">LinkedIn</a>}
            <a href="/privacy/">Privacy notice</a>
            <a href={staffLogin} rel="nofollow">Staff login</a>
          </div>
        </div>
      </div>
      <div class="wrap copyright">© {year} {company.legalName}</div>
    </footer>
  </body>
</html>

<style>
  .site-header { background: var(--bg); border-bottom: 1px solid var(--rule); position: sticky; top: 0; z-index: 10; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 76px; padding-top: 10px; padding-bottom: 10px; }
  /* Full-colour stacked logo, as on the booking system */
  .brand { display: block; text-decoration: none; }
  .brand img { height: 72px; width: auto; }
  .brand--footer img { height: 120px; }

  .menu summary { list-style: none; cursor: pointer; padding: 10px 18px; border: 1px solid var(--rule-strong); border-radius: 999px; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu nav { position: absolute; right: 16px; left: 16px; top: 88px; background: var(--bg-raised); border: 1px solid var(--rule); border-radius: var(--radius); padding: 8px; }
  .menu ul { list-style: none; margin: 0; padding: 0; }
  .menu a { display: block; padding: 12px; text-decoration: none; font-size: 0.9375rem; }
  .menu a[aria-current='page'] { color: var(--com); }
  .nav-cta { margin-top: 8px; text-align: center; border-radius: 999px; background: var(--com-deep); color: var(--on-accent); font-weight: 600; }
  .nav-cta:hover { background: var(--com-deep-hover); opacity: 1; }

  @media (min-width: 960px) {
    .menu summary { display: none; }
    .menu nav { position: static; display: block; border: 0; padding: 0; background: none; }
    .menu ul { display: flex; align-items: center; gap: 28px; }
    .menu a { padding: 8px 0; }
    .nav-cta { margin: 0; padding: 12px 20px !important; }
  }

  .site-footer { border-top: 1px solid var(--rule); padding: 48px 0 24px; font-size: 0.875rem; color: var(--text-faint); }
  .site-footer a { text-decoration: none; }
  .footer-grid { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 32px; }
  .footer-brand { display: flex; flex-direction: column; gap: 12px; max-width: 360px; }
  .footer-cols { display: flex; flex-wrap: wrap; gap: 48px; }
  .footer-cols > div { display: flex; flex-direction: column; gap: 10px; }
  .footer-cols strong { color: var(--text); font-weight: 600; }
  .copyright { margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--rule); font-size: 0.8125rem; }
</style>

<script>
  // Desktop: keep the nav open; mobile: collapsible.
  const menu = document.querySelector<HTMLDetailsElement>('.menu');
  const mq = window.matchMedia('(min-width: 960px)');
  const sync = () => { if (menu) menu.open = mq.matches; };
  sync();
  mq.addEventListener('change', sync);
</script>
