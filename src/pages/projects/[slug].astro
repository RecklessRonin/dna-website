---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---
<Base title={d.title} description={d.summary}>
  <article class="section">
    <div class="wrap prose">
      <p class="eyebrow">{d.sector} · {d.year}{d.location ? ` · ${d.location}` : ''}</p>
      <h1>{d.title}</h1>
      <p class="lead">{d.summary}</p>
      {d.image && <img src={d.image} alt="" loading="lazy" />}
      {(d.systems.length > 0 || d.services.length > 0) && (
        <ul class="tags" style="margin:1.5em 0">
          {[...d.systems, ...d.services].map((t) => <li>{t}</li>)}
        </ul>
      )}
      <Content />
      <p style="margin-top:2em"><a href="/projects/">All projects</a></p>
    </div>
  </article>
</Base>
