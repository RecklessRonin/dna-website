---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { company, cta, accreditations } from '../config';
import { commercial, steps, domestic, sectors, handover, systems } from '../data';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 2);

// Commissioning is covered by the steps and the handover section, so the homepage grid leaves it out.
const services = commercial.filter((s) => s.id !== 'commissioning');

const pad = (n: number) => String(n + 1).padStart(2, '0');
const arrow = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>';
---
<Base
  title={company.name}
  description="Your site. Your system. Your keys. BMS and HVAC controls for offices, schools, healthcare and industrial sites, with every login, file and licence handed over. Based in Telford, Shropshire."
>
  <!-- 1. HERO -->
  <section class="hero wrap">
    <p class="eyebrow">By engineers, for engineers</p>
    <h1>Your site. Your system. <span class="accent">Your keys.</span></h1>
    <p class="tagline">We build it, you own it.</p>
    <p class="lead">We design, install, upgrade and maintain BMS and HVAC controls for offices, schools, healthcare and industrial sites. At handover you get every login, file and licence, so you're never locked in.</p>
    <p class="actions">
      <a class="btn" href={cta.href}>{cta.label} <Fragment set:html={arrow} /></a>
      <a class="btn btn--ghost" href="#handover">What you get at handover</a>
    </p>
  </section>

  <!-- 2. HANDOVER PROMISE -->
  <section id="handover" class="section handover">
    <div class="wrap">
      <div class="intro">
        <div>
          <p class="eyebrow">What you get at handover</p>
          <h2>We build it, you own it.</h2>
        </div>
        <p class="intro-text">Too many building owners can't change a time schedule without calling the company that installed their BMS. We hand everything over, so you're free to use any engineer, including us.</p>
      </div>
      <ul class="promises">
        {handover.map((h) => (
          <li>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={h.icon} /></svg>
            <h3>{h.title}</h3>
            <p>{h.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. INHERITED SYSTEMS -->
  <div class="wrap">
    <div class="legacy">
      <div>
        <h2>Inherited a system nobody else can support? <span class="accent">We can.</span></h2>
        <p>We'll take it on as it is, get it working and hand you the keys. Then we upgrade only what needs it.</p>
      </div>
      <a class="btn" href={cta.href}>{cta.label}</a>
    </div>
  </div>

  <!-- 4. WHAT WE DO -->
  <section id="commercial" class="section">
    <div class="wrap">
      <div class="intro">
        <div>
          <p class="eyebrow">What we do · Building management systems</p>
          <h2>Controls that cut energy use and keep plant compliant.</h2>
        </div>
        <p class="intro-text">From a single plant room to a multi-site estate: new installations, upgrades to legacy systems and ongoing maintenance.</p>
      </div>

      <div class="grid grid--3 com-grid">
        {services.map((s, i) => (
          <a class="card com-card" href={`/services/#${s.id}`}>
            <span class="num">{pad(i)}</span>
            <div><h3>{s.title}</h3><p>{s.summary}</p></div>
          </a>
        ))}
      </div>

      <ol class="steps">
        {steps.map((s, i) => (
          <li class={i === 0 ? 'first' : ''}>
            <span class="num">{pad(i)}</span>
            <h3>{s.title}</h3>
            <p>{s.summary}</p>
          </li>
        ))}
      </ol>

      <p class="more"><a href="/services/">More on our BMS services <Fragment set:html={arrow} /></a></p>
    </div>
  </section>

  <!-- 5. PLATFORMS, SECTORS, ACCREDITATIONS -->
  <section class="section section--white platforms">
    <div class="wrap">
      <div class="facts">
        <div>
          <h2>Platforms we work on</h2>
          <ul class="tags">{systems.map((s) => <li>{s.name}</li>)}</ul>
          <p class="more"><a href="/systems/">Platform details <Fragment set:html={arrow} /></a></p>
        </div>
        <div>
          <h2>Sectors</h2>
          <ul class="tags">{sectors.map((s) => <li>{s}</li>)}</ul>
        </div>
        {accreditations.length > 0 && (
          <div>
            <h2>Accreditations</h2>
            <ul class="trust-logos">
              {accreditations.map((a) => (
                <li>{a.logo ? <img src={a.logo} alt={a.name} /> : a.name}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- 6. PROJECTS (hidden until a non-draft project exists) -->
  {projects.length > 0 && (
    <section id="projects" class="section wrap">
      <div class="projects-head">
        <h2>Recent projects</h2>
        <a href="/projects/">View all projects →</a>
      </div>
      <div class="grid grid--3 projects">
        {projects.map((p) => (
          <a class={`project project--${p.data.kind}`} href={`/projects/${p.id}/`}>
            <div class="project-img">{p.data.image && <img src={p.data.image} alt="" loading="lazy" />}</div>
            <div>
              <span class="eyebrow">{p.data.kind === 'domestic' ? 'Domestic' : 'Commercial'}</span>
              <h3>{p.data.title}</h3>
              <p>{[p.data.location, p.data.summary].filter(Boolean).join(' · ')}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- 7. DOMESTIC TEASER -->
  <section id="domestic" class="wrap">
    <a class="dom-teaser" href="/domestic/">
      <div>
        <p class="eyebrow">Also from {company.name} · Domestic</p>
        <h2>Home automation for larger homes</h2>
        <p>The same controls engineering, applied to lighting, heating and security at home.</p>
        <ul class="tags">{domestic.map((d) => <li>{d.title}</li>)}</ul>
      </div>
      <span class="dom-link">Home automation <Fragment set:html={arrow} /></span>
    </a>
  </section>

  <!-- 8. CTA -->
  <section class="wrap cta-wrap">
    <div class="cta">
      <div>
        <h2>Tell us about your site.</h2>
        <p>Reviewing your BMS, planning a fit-out or looking for a maintenance partner? Start with a no-obligation site survey.</p>
      </div>
      <p class="actions">
        <a class="btn" href={cta.href}>{cta.label}</a>
        <a class="btn btn--ghost" href="/contact/?type=domestic">Home automation enquiry</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 88px; padding-bottom: 96px; }
  .hero h1 { max-width: 1000px; }
  .hero h1 .accent { color: var(--com); white-space: nowrap; }
  .tagline { margin: 20px 0 0; font-family: var(--font-head); font-weight: 500; font-size: clamp(1.375rem, 2.6vw, 1.875rem); color: var(--text-soft); }
  .hero .lead { margin-top: 24px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 36px 0 0; }

  /* Section intros */
  .intro { display: flex; flex-wrap: wrap; gap: 40px 64px; align-items: flex-end; justify-content: space-between; }
  .intro > div { max-width: 660px; }
  .intro h2 { margin: 0; font-size: clamp(2rem, 4.2vw, 3.25rem); line-height: 1.08; }
  .intro-text { margin: 0; max-width: 420px; font-size: 1.0625rem; color: var(--text-soft); }
  .more { margin: 40px 0 0; }
  .more a { display: inline-flex; align-items: center; gap: 8px; color: var(--com); font-weight: 600; text-decoration: none; }

  /* Handover promise */
  .handover { padding-top: 0; }
  .promises { list-style: none; margin: 56px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 32px 28px; }
  .promises li { border-top: 2px solid var(--com); padding-top: 22px; display: flex; flex-direction: column; gap: 10px; }
  .promises svg { color: var(--com); }
  .promises h3 { margin: 4px 0 0; font-size: 1.125rem; }
  .promises p { margin: 0; font-size: 0.9375rem; color: var(--text-soft); }

  /* Inherited systems */
  .legacy { padding: 28px 32px; border-radius: 14px; background: var(--bg-raised); border: 1px solid var(--rule-strong); border-left: 4px solid var(--com); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; }
  .legacy h2 { margin: 0; font-size: clamp(1.25rem, 2.2vw, 1.5rem); line-height: 1.25; }
  .legacy h2 .accent { color: var(--com); white-space: nowrap; }
  .legacy p { margin: 8px 0 0; color: var(--text-soft); font-size: 0.9375rem; }

  /* What we do */
  .com-grid { margin-top: 64px; }
  .com-card { display: flex; gap: 20px; align-items: flex-start; text-decoration: none; }
  .com-card:hover { border-color: var(--com-line); opacity: 1; }
  .com-card h3 { margin: 0 0 8px; font-size: 1.1875rem; }
  .com-card p { font-size: 0.9375rem; color: var(--text-soft); }
  .num { font-family: var(--font-head); font-size: 0.8125rem; font-weight: 600; color: var(--com); padding-top: 4px; }
  .steps { list-style: none; margin: 72px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 32px; }
  .steps li { border-top: 2px solid var(--rule-strong); padding-top: 20px; }
  .steps li.first { border-top-color: var(--com); }
  .steps h3 { margin: 8px 0; font-size: 1.125rem; }
  .steps p { margin: 0; font-size: 0.9375rem; color: var(--text-soft); }

  /* Platforms, sectors, accreditations */
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 48px; }
  .facts h2 { font-size: 1.5rem; margin-bottom: 20px; }
  .facts .more { margin-top: 20px; }
  .trust-logos { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 32px; list-style: none; margin: 0; padding: 0; }
  .trust-logos img { height: 40px; width: auto; }

  /* Projects */
  .projects-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px; }
  .projects-head h2 { margin: 0; }
  .projects-head a { font-size: 0.9375rem; padding: 12px 0; }
  .projects { margin-top: 40px; gap: 24px; }
  .project { text-decoration: none; display: flex; flex-direction: column; gap: 18px; }
  .project-img { height: 340px; border-radius: 14px; overflow: hidden; background: var(--com-panel); border: 1px solid var(--com-line); }
  .project--domestic .project-img { background: var(--dom-panel); border-color: var(--dom-line); }
  .project-img img { width: 100%; height: 100%; object-fit: cover; }
  .project .eyebrow { margin: 0; font-size: 0.8125rem; letter-spacing: 0.14em; }
  .project h3 { margin: 8px 0 6px; font-size: 1.375rem; }
  .project p { margin: 0; font-size: 0.9375rem; color: var(--text-faint); }

  /* Domestic teaser */
  #domestic { padding-top: 96px; }
  .dom-teaser { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px 48px; padding: clamp(28px, 4vw, 44px); border-radius: 18px; background: var(--dom-panel); border: 1px solid var(--dom-line); text-decoration: none; }
  .dom-teaser:hover { opacity: 1; border-color: var(--com-line); }
  .dom-teaser > div { max-width: 720px; }
  .dom-teaser h2 { margin: 0; font-size: clamp(1.5rem, 2.8vw, 2rem); }
  .dom-teaser p:not(.eyebrow) { margin: 12px 0 20px; color: var(--text-soft); }
  .dom-link { display: inline-flex; align-items: center; gap: 8px; color: var(--com); font-weight: 600; }

  /* Closing CTA */
  .cta-wrap { padding-top: 96px; padding-bottom: 112px; }
  .cta { border-radius: 20px; border: 1px solid var(--rule-strong); background: var(--bg-raised); padding: clamp(28px, 5vw, 72px); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px; }
  .cta > div { max-width: 560px; }
  .cta h2 { margin: 0; font-size: clamp(1.75rem, 3.4vw, 2.625rem); }
  .cta p { margin: 14px 0 0; color: var(--text-soft); }
  .cta .actions { margin: 0; }
</style>
